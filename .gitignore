# ---- Alert-Forge .gitignore ----

# Raw dataset (about 600 MB; download from the UNSW-NB15 source instead of committing it)
data/

# Generated outputs: flows, frozen models, predictions, streams, incidents, experiment results.
# Everything here can be regenerated by running the pipeline.
artifacts/
artifacts_*/

# Model and data binaries, wherever they end up
*.joblib
*.pkl
*.parquet
*.zip

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Secrets / local config
.env
.env.*

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/launch.json

# Saved console output
phase3_results.txt
phase3b_results.txt
*.log

# Accidental duplicates (e.g. "build_chains copy.py")
* copy.*
